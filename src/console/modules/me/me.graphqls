"""
A role in the console. On a tenant: what the caller holds there directly. On
the platform: the caller's operator role.
"""
enum Role {
  OWNER
  ADMIN
  VIEWER
}

"A tenant of the platform, as the console names it."
type Tenant {
  id: ID!
  slug: String!
  name: String!
}

"A signed-in console user: a user of the `clavix` tenant."
type ConsoleUser {
  id: ID!
  email: EmailAddress!
  name: String
}

"A role the caller holds directly on a tenant."
type Membership {
  tenant: Tenant!
  role: Role!
}

"A tenant the caller can switch to, with the role they act with there."
type SwitchableTenant {
  tenant: Tenant!
  "The strongest of the caller's direct role on the tenant and their platform role."
  role: Role!
}

"A page of switchable tenants, by slug; `nextCursor` is `null` on the last."
type SwitchableTenantPage {
  items: [SwitchableTenant!]!
  nextCursor: String
}

"The caller: who the bearer token belongs to, and where they have a role."
type Me {
  user: ConsoleUser!
  "The caller's platform role, `null` for a tenant member who is not an operator."
  platformRole: Role
  "The tenants where the caller holds a role directly. A platform operator is also allowed on every tenant, which `tenants` (platform) lists."
  memberships: [Membership!]!
  """
  The tenants the caller can work on, by slug: those of their memberships and,
  for a platform operator, every tenant not in the trash. A suspended tenant is
  listed (read `tenant.status`; the console stays readable on it); a tenant in
  the trash is not. `q` matches the start of the slug or part of the name.
  `first` is 1 to 100 (default 25). A caller with no role gets an empty page.
  """
  switchableTenants(
    q: String
    after: String
    first: Int = 25
  ): SwitchableTenantPage!
}

type Query {
  me: Me!
}
