"An end user of a tenant: someone who signs in through that tenant's issuer (not a console admin)."
type TenantUser {
  id: ID!
  email: EmailAddress!
  name: String
  emailVerified: Boolean!
  "False once a console admin disabled the user: no sign-in, no new token."
  active: Boolean!
  createdAt: DateTime!
}

"""
A page of a tenant's users, oldest first; `nextCursor` is `null` on the last.
With `email` the page holds that one user, or none.
"""
type TenantUserPage {
  items: [TenantUser!]!
  nextCursor: String
}

"A pending invitation into a tenant's user pool. The code only goes by e-mail."
type UserInvitation {
  id: ID!
  email: EmailAddress!
  invitedAt: DateTime!
  expiresAt: DateTime!
}

"What a user allowed an application to do (an OAuth grant), standing only."
type UserGrant {
  id: ID!
  clientId: String!
  "The client's name, or `null` when the client was deleted since."
  clientName: String
  "The resource (audience) the grant is for."
  resource: String!
  scopes: [String!]!
  createdAt: DateTime!
  "When the scopes were last set by a consent."
  updatedAt: DateTime!
}

extend type Query {
  """
  The users of a tenant (tenant viewer). `first` defaults to 25, at most 100.
  `email` finds the user with exactly that address (any case, spaces around
  ignored); a prefix search waits on janus.
  """
  users(
    tenantId: ID!
    after: String
    first: Int
    email: String
  ): TenantUserPage!
  "One user of the tenant (tenant viewer), or `null`: unknown, or of another tenant."
  user(tenantId: ID!, id: ID!): TenantUser
  "The pending, unlapsed invitations into the tenant's user pool (tenant viewer)."
  userInvitations(tenantId: ID!): [UserInvitation!]!
  "The user's standing grants, oldest first (tenant viewer). Empty for an unknown user."
  userGrants(tenantId: ID!, userId: ID!): [UserGrant!]!
}

extend type Mutation {
  """
  Invites an e-mail address into the tenant's user pool (tenant admin). The
  invitee accepts on the tenant's hosted `/invitation` page, which makes the
  account (e-mail proved), even when sign-up is closed. A pending invitation of
  the same address is replaced (a new mail goes out). Errors: USER_EXISTS (409)
  when the address already has an account in the tenant, NOT_FOUND for an
  unknown tenant.
  """
  inviteUser(tenantId: ID!, email: EmailAddress!): UserInvitation!
  "Revokes a pending invitation of the tenant (tenant admin). True also when there is none."
  revokeInvitation(tenantId: ID!, invitationId: ID!): Boolean!
  """
  Disables a user (tenant admin): their sessions end at once and the
  applications they allowed get no new token. Idempotent. Errors: NOT_FOUND for
  an unknown user.
  """
  disableUser(tenantId: ID!, userId: ID!): TenantUser!
  "Enables a disabled user again (tenant admin). Idempotent. Errors: NOT_FOUND for an unknown user."
  enableUser(tenantId: ID!, userId: ID!): TenantUser!
  """
  Deletes a user for good (tenant admin): their sessions and grants (and the
  tokens those opened) go with them. True also when the user was already gone.
  """
  deleteUser(tenantId: ID!, userId: ID!): Boolean!
  "Ends every session of the user (tenant admin); answers how many it ended. 0 on a repeat or an unknown user."
  revokeUserSessions(tenantId: ID!, userId: ID!): Int!
  """
  Takes back one grant of the user and the tokens it opened (tenant admin).
  True also when the grant was already revoked; false when it is not this
  user's (or does not exist).
  """
  revokeGrant(tenantId: ID!, userId: ID!, grantId: ID!): Boolean!
}
