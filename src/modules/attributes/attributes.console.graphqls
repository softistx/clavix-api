"Who an attribute describes."
enum AttributeFamily {
  "Every user of the tenant."
  USER
  "Only the holders of the roles the attribute is linked to."
  ROLE
}

"What an attribute holds. Its values are canonical per type."
enum AttributeType {
  STRING
  TEXT
  COLOR
  NUMBER
  DATE
  DATETIME
  TIME
  SELECT
  MULTI_SELECT
  BOOLEAN
}

"One choice of a SELECT or MULTI_SELECT attribute. Its `key` is the stored (and emitted) value."
type UserAttributeOption {
  key: String!
  label: [Translation!]!
    @listSize(assumedSize: 3, requireOneSlicingArgument: false)
}

"""
The link between a role-family attribute and one precise role (a role is per
tenant and per resource): a user shows the attribute while it holds the role.
`required` is this role's own flag: a console save cannot clear the value in
the role's section. Removing the role (or the link) hides the values without
deleting them; they show again when the link comes back.
"""
type RoleAttributeLink {
  role: TenantRole!
  required: Boolean!
}

"""
An extra field of the tenant's users (family `USER`) or of the holders of some
roles (family `ROLE`). The `key` is the claim name and never changes; it stays
taken while the attribute is archived, and only the permanent delete frees it.
"""
type UserAttribute {
  id: ID!
  "2 to 64 characters: a lower-case letter, then lower-case letters, digits and `_`."
  key: String!
  family: AttributeFamily!
  type: AttributeType!
  label: [Translation!]!
    @listSize(assumedSize: 3, requireOneSlicingArgument: false)
  description: [Translation!]!
    @listSize(assumedSize: 3, requireOneSlicingArgument: false)
  "The unit a value is shown with (`kg`, `%`), or `null`."
  unit: String
  "The choices of a SELECT or MULTI_SELECT attribute, in order; empty for the other types."
  options: [UserAttributeOption!]!
    @listSize(assumedSize: 20, requireOneSlicingArgument: false)
  required: Boolean!
  "Whether the user may set its own value (profile or `/userinfo` write); never with an emission scope."
  userEditable: Boolean!
  "Whether two users may not hold the same value. Only STRING and NUMBER."
  unique: Boolean!
  "The scope whose token carries the value as a claim, or `null` when it is not emitted."
  emissionScope: String
  "When the attribute was archived, or `null` while it is live."
  archivedAt: DateTime
  "How many users hold a value of the attribute."
  valueCount: Int!
  "The roles the attribute is linked to (family `ROLE`), by role name; empty for a user attribute."
  roles: [RoleAttributeLink!]!
    @listSize(assumedSize: 10, requireOneSlicingArgument: false)
  "The version to send back to `updateUserAttribute`."
  version: Int!
}

input UserAttributeOptionInput {
  "1 to 63 characters: a lower-case letter or digit, then lower-case letters, digits, `_` and `-`."
  key: String!
  label: [TranslationInput!]!
}

input CreateUserAttributeInput {
  "Never changes. See `UserAttribute.key`; reserved claim names are refused."
  key: String!
  "Never changes."
  family: AttributeFamily!
  type: AttributeType!
  "At least one language, 100 characters at most each."
  label: [TranslationInput!]!
  "300 characters at most each."
  description: [TranslationInput!]
  unit: String
  "Required (1 to 100) for SELECT and MULTI_SELECT, refused for the other types."
  options: [UserAttributeOptionInput!]
  required: Boolean
  userEditable: Boolean
  unique: Boolean
  emissionScope: String
}

"A field left out keeps its value; `null` clears `unit` and `emissionScope`."
input UpdateUserAttributeInput {
  type: AttributeType
  "Sets or replaces the languages it names and keeps the others; a blank text removes one."
  label: [TranslationInput!]
  description: [TranslationInput!]
  unit: String
  "Replaces the whole list."
  options: [UserAttributeOptionInput!]
  required: Boolean
  userEditable: Boolean
  unique: Boolean
  emissionScope: String
}

"""
One attribute of a user's section and the value the user holds. Exactly the
field of the attribute's type is set (`text` for STRING and TEXT, `color`,
`number`, `date`, `dateTime`, `time`, `options` for SELECT and MULTI_SELECT,
`boolean`); every field is `null` while the user holds no value.
"""
type AttributeValue {
  attribute: UserAttribute!
  text: String
  color: HexColorCode
  number: Float
  boolean: Boolean
  date: Date
  dateTime: DateTime
  time: LocalTime
  "The keys of the chosen options (one for SELECT)."
  options: [String!]
    @listSize(assumedSize: 20, requireOneSlicingArgument: false)
}

"""
The values of one role's attributes, for a user who holds the role. Each
attribute's `required` is the role link's. One value per user and attribute
whatever the number of roles: two roles that link the same attribute show the
same value.
"""
type RoleAttributeSection {
  role: TenantRole!
  values: [AttributeValue!]!
    @listSize(assumedSize: 20, requireOneSlicingArgument: false)
}

"""
What a user holds, by section: `general` is every live attribute of family
`USER`, by position; `roles` has one section per held role (by name) that is
linked to live attributes. The values of an archived attribute, of a role no
longer held or whose link was removed are not shown (they stay stored).
"""
type UserAttributeSections {
  general: [AttributeValue!]!
    @listSize(assumedSize: 100, requireOneSlicingArgument: false)
  roles: [RoleAttributeSection!]!
    @listSize(assumedSize: 20, requireOneSlicingArgument: false)
}

extend type TenantUser {
  "The user's attribute values by section, hidden ones left out (tenant viewer)."
  attributes: UserAttributeSections!
  "False while the user lacks a value of a live required attribute of the general section (tenant viewer)."
  attributesComplete: Boolean!
}

"""
Which section a save is about: `roleId` null for the general section, else the
role whose section is saved (the user must hold it).
"""
input AttributeSectionInput {
  roleId: ID
}

"""
The value to set, through the one field of the attribute's type (`text` for
STRING and TEXT, `color`, `number`, `date`, `dateTime`, `time`, `options` for
SELECT and MULTI_SELECT, `boolean`).
"""
input AttributeValueSetInput @oneOf {
  text: String
  color: HexColorCode
  number: Float
  boolean: Boolean
  date: Date
  dateTime: DateTime
  time: LocalTime
  options: [String!]
}

"One change of a save: `value` null clears the attribute's value."
input AttributeValueInput {
  attributeId: ID!
  value: AttributeValueSetInput
}

"""
One attribute value in a user's data export, hidden ones included (an archived
attribute, a value written under another type). Exactly the field of the
attribute's type is set.
"""
type ExportedAttributeValue {
  key: String!
  label: [Translation!]!
    @listSize(assumedSize: 3, requireOneSlicingArgument: false)
  "True when the user does not see the value (its attribute is archived, its type changed, or no role the user holds links it)."
  hidden: Boolean!
  "The names of the held roles whose section holds the attribute; empty for the general section."
  roles: [String!]! @listSize(assumedSize: 20, requireOneSlicingArgument: false)
  text: String
  color: HexColorCode
  number: Float
  boolean: Boolean
  date: Date
  dateTime: DateTime
  time: LocalTime
  options: [String!]
    @listSize(assumedSize: 20, requireOneSlicingArgument: false)
  updatedAt: DateTime!
}

extend type Query {
  "The tenant's attributes by position (tenant viewer), the live ones or, with `archived`, the archived ones. All families unless `family` is given."
  userAttributes(
    tenantId: ID!
    family: AttributeFamily
    archived: Boolean = false
  ): [UserAttribute!]!
  "One attribute (tenant viewer), or `null`: unknown, or of another tenant."
  userAttribute(tenantId: ID!, id: ID!): UserAttribute
}

extend type Mutation {
  """
  Creates an attribute at the end of its family (tenant admin). Errors:
  ATTRIBUTE_KEY_INVALID, ATTRIBUTE_KEY_RESERVED, ATTRIBUTE_UNIQUE_UNSUPPORTED,
  ATTRIBUTE_EDITABLE_EMITTED and ATTRIBUTE_SCOPE_UNKNOWN (400),
  ATTRIBUTE_KEY_TAKEN (409, an archived attribute keeps its key) and
  ATTRIBUTE_LIMIT (409, 100 per tenant).
  """
  createUserAttribute(
    tenantId: ID!
    input: CreateUserAttributeInput!
  ): UserAttribute!
  """
  Changes an attribute at the `version` read (tenant admin); nothing is written
  when nothing changes. Errors: CONFLICT (stale version), NOT_FOUND,
  ATTRIBUTE_ARCHIVED, ATTRIBUTE_TYPE_LOCKED and ATTRIBUTE_OPTION_IN_USE
  (users hold values), ATTRIBUTE_NOT_UNIQUE (stored values repeat), plus the
  400 refusals of `createUserAttribute`.
  """
  updateUserAttribute(
    tenantId: ID!
    id: ID!
    version: Int!
    input: UpdateUserAttributeInput!
  ): UserAttribute!
  "Puts the attribute at `position` (0-based) among the live ones of its family (tenant admin). Errors: NOT_FOUND, ATTRIBUTE_ARCHIVED."
  moveUserAttribute(tenantId: ID!, id: ID!, position: Int!): UserAttribute!
  "Hides the attribute from lists and tokens; its key and values stay (tenant admin). Idempotent. Errors: NOT_FOUND."
  archiveUserAttribute(tenantId: ID!, id: ID!): UserAttribute!
  "Brings an archived attribute back (tenant admin). Idempotent. Errors: NOT_FOUND."
  restoreUserAttribute(tenantId: ID!, id: ID!): UserAttribute!
  """
  Deletes an archived attribute and every value it holds, and frees its key
  (tenant owner). `confirmKey` must be its key. True also when it is already
  gone. Errors: ATTRIBUTE_NOT_ARCHIVED (409), ATTRIBUTE_DELETE_UNCONFIRMED (400).
  """
  deleteUserAttribute(tenantId: ID!, id: ID!, confirmKey: String!): Boolean!
  """
  Sets and clears a user's values in one section (tenant admin) and returns
  the sections as they stand. A bad value writes nothing. Required attributes
  (the role link's flag in a role section) cannot be cleared here. Errors:
  NOT_FOUND (user, or attribute at `values.<i>`), ATTRIBUTE_ARCHIVED,
  ATTRIBUTE_FAMILY_MISMATCH (400, field `values.<i>`: a role attribute in the
  general section, a user attribute or one not linked to the role in a role's),
  ATTRIBUTE_VALUE_INVALID (400, field `values.<i>`), ATTRIBUTE_REQUIRED (400),
  ATTRIBUTE_VALUE_TAKEN (409, a `unique` attribute) and ATTRIBUTE_ROLE_NOT_HELD
  (409, field `section.roleId`: the user does not hold the role).
  """
  setUserAttributeValues(
    tenantId: ID!
    userId: ID!
    section: AttributeSectionInput!
    values: [AttributeValueInput!]!
  ): UserAttributeSections!
  """
  Links a role-family attribute to one role, `required` for that role only
  (tenant admin), and returns the attribute. Idempotent: a repeat sets
  `required`. Errors: NOT_FOUND (role or attribute), ATTRIBUTE_FAMILY_MISMATCH
  (400, a user-family attribute) and ATTRIBUTE_ARCHIVED (409).
  """
  assignRoleAttribute(
    tenantId: ID!
    roleId: ID!
    attributeId: ID!
    required: Boolean = false
  ): UserAttribute!
  "Changes the `required` flag of a link (tenant admin) and returns the attribute. Errors: NOT_FOUND (role, attribute, or no such link)."
  updateRoleAttribute(
    tenantId: ID!
    roleId: ID!
    attributeId: ID!
    required: Boolean!
  ): UserAttribute!
  """
  Removes the link (tenant admin); `true` when there was one. The users' values
  stay stored and hidden: nothing else is written. Idempotent.
  """
  unassignRoleAttribute(tenantId: ID!, roleId: ID!, attributeId: ID!): Boolean!
}
