"Whether a client keeps a secret (a back end) or proves itself with PKCE only."
enum ClientType {
  PUBLIC
  CONFIDENTIAL
}

"A grant type recorded on a client."
enum ClientGrantType {
  AUTHORIZATION_CODE
  REFRESH_TOKEN
  "The device authorization grant (RFC 8628, `urn:ietf:params:oauth:grant-type:device_code`), for a CLI or a TV. Never implied: a client opts in."
  DEVICE_CODE
  "The token exchange grant (RFC 8693, `urn:ietf:params:oauth:grant-type:token-exchange`), for a confidential back end. Never implied, and refused until `setClientTokenExchange` sets the client's rules."
  TOKEN_EXCHANGE
  "The client credentials grant (RFC 6749 section 4.4): a back end asks for an access token of its own, with no user. For a confidential client only, never implied, with `allowedScopes`, and served only for a resource that opted in (`Resource.allowClientCredentials`)."
  CLIENT_CREDENTIALS
}

"""
How a client came to be. `DYNAMIC` and `METADATA` are the tenant's agents (MCP
clients and other apps that registered themselves, see `OAuthPolicy.agents`).
"""
enum ClientRegistration {
  "Registered by an admin in the console or by a script."
  CONSOLE
  "The client registered itself at `/register` (RFC 7591)."
  DYNAMIC
  "A Client ID Metadata Document (its URL is the client id) describes the client; recorded at its first use."
  METADATA
}

"How an exchanged token names the client acting for the user."
enum TokenExchangeMode {
  "The exchanged token is the user's, issued to the client, and carries `act` (the client acts for the user). The only mode."
  DELEGATION
}

"""
What a client may do with the token exchange grant. Default-deny: a client with
no rules cannot exchange. The exchanged token's scopes only narrow the subject
token's, it has no refresh token, and it never outlives the subject token.
"""
type ClientTokenExchange {
  "URIs of the tenant's resources the exchanged token may be issued for."
  targetResources: [String!]!
  "Ids of the clients whose tokens may be exchanged. Empty with `anySubjectClient`."
  subjectClients: [String!]!
  "Whether a token of any client of the tenant may be exchanged."
  anySubjectClient: Boolean!
  "Whether the tokens of any agent of the tenant (a client that registered itself) may be exchanged too. A client that is no agent is not covered."
  subjectAgents: Boolean!
  mode: TokenExchangeMode!
}

"An OAuth client of a tenant."
type Client {
  "The client_id."
  id: ID!
  name: String!
  type: ClientType!
  "Exact-match redirect URIs. Empty for a device-only client (no `AUTHORIZATION_CODE`)."
  redirectUris: [String!]!
  """
  The grant types the client may use, enforced by the token and device
  authorization endpoints (`unauthorized_client` for another).
  `AUTHORIZATION_CODE` and `REFRESH_TOKEN` when the client records none.
  """
  grantTypes: [ClientGrantType!]!
  createdAt: DateTime!
  """
  Whether the client must push its authorization requests to `/par` (RFC 9126).
  A tenant that requires it of everyone (`oauthPolicy.par.required`) overrides
  this: every client pushes.
  """
  requirePushedAuthorizationRequests: Boolean!
  """
  Whether the client's token requests must carry a DPoP proof (RFC 9449): its
  access tokens are bound to its key, and a public client's refresh token too.
  A tenant that requires DPoP of everyone (`oauthPolicy.dpop.required`)
  overrides this: every client sends a proof.
  """
  dpopBoundAccessTokens: Boolean!
  """
  The authorization detail types (RFC 9396, `Resource.detailTypes`) the client
  may ask for; empty when it lists none. Never implied.
  """
  authorizationDetailsTypes: [String!]!
  """
  The scopes the client may ask for with `CLIENT_CREDENTIALS`: a request is cut
  to them. Empty without that grant.
  """
  allowedScopes: [String!]!
  "The scopes a `CLIENT_CREDENTIALS` request with no `scope` gets (within `allowedScopes`)."
  defaultScopes: [String!]!
  "The token exchange rules; `null` while none is set (the client cannot exchange)."
  tokenExchange: ClientTokenExchange
  "How the client came to be: `createdAt` is its registration time. An agent (`DYNAMIC`, `METADATA`) is read-only in the console and can be deleted."
  registration: ClientRegistration!
}

"""
A page of a tenant's clients; `nextCursor` is `null` on the last. A page may
hold fewer than `first` items, even none, with a `nextCursor` (a search with
`q` does): follow it until it is `null`.
"""
type ClientPage {
  items: [Client!]!
  nextCursor: String
  "How many clients match `q` in all (every client without it), whatever the cursor or the page's size."
  totalCount: Int!
}

"A client just created. The secret of a confidential client is in `clientSecret`, here and nowhere else."
type CreatedClient {
  client: Client!
  clientSecret: String
}

"A client whose secret was just rotated. The old secret no longer works; the new one is shown once."
type RotatedClientSecret {
  client: Client!
  clientSecret: String!
}

input CreateClientInput {
  name: String!
  type: ClientType!
  "At least one unless the client has no `AUTHORIZATION_CODE` grant (a device-only client needs none). Default: none."
  redirectUris: [String!]
  """
  The grants the client may use. Default: `AUTHORIZATION_CODE` and `REFRESH_TOKEN`.
  A list needs `AUTHORIZATION_CODE`, `DEVICE_CODE`, `TOKEN_EXCHANGE` or `CLIENT_CREDENTIALS`; add
  `REFRESH_TOKEN` for a client that refreshes. Without `AUTHORIZATION_CODE` the client needs no
  redirect URI. `TOKEN_EXCHANGE` and `CLIENT_CREDENTIALS` need a `CONFIDENTIAL` client
  (BAD_USER_INPUT otherwise).
  """
  grantTypes: [ClientGrantType!]
  "The client_id (a-z, 0-9, `-`); default: the name. Creating an existing id is a CONFLICT, unless the call repeats it (same name, type and redirect URIs)."
  clientId: String
  "Make the client push its authorization requests. Default false."
  requirePushedAuthorizationRequests: Boolean
  "Bind the client's tokens to a DPoP key. Default false."
  dpopBoundAccessTokens: Boolean
  """
  The detail types the client may ask for: the names of the tenant's types.
  BAD_USER_INPUT for an unknown type, or without `requirePushedAuthorizationRequests`
  (details in a URL are not protected). Default: none.
  """
  authorizationDetailsTypes: [String!]
  """
  The scopes the client may ask for with `CLIENT_CREDENTIALS` (at least one with that
  grant, BAD_USER_INPUT otherwise; without the grant none is allowed).
  """
  allowedScopes: [String!]
  "The scopes a request with no `scope` gets: within `allowedScopes`. Default: none."
  defaultScopes: [String!]
}

"Fields left out stay as they are. The type and the secret never change here."
input UpdateClientInput {
  name: String
  redirectUris: [String!]
  "Replaces the grants (same rules as on creation)."
  grantTypes: [ClientGrantType!]
  requirePushedAuthorizationRequests: Boolean
  dpopBoundAccessTokens: Boolean
  "Replaces the detail types (same rules as on creation); `[]` clears them, left out keeps them."
  authorizationDetailsTypes: [String!]
  "Replaces the `CLIENT_CREDENTIALS` scope ceiling; left out keeps it (it is dropped with the grant)."
  allowedScopes: [String!]
  "Replaces the `CLIENT_CREDENTIALS` default scopes; left out keeps them."
  defaultScopes: [String!]
}

"The rules of `setClientTokenExchange`: they replace the client's current ones."
input ClientTokenExchangeInput {
  "Resource URIs of the tenant. Empty: the client can exchange for none."
  targetResources: [String!]!
  "The ids of the clients whose tokens may be exchanged (at most 50). Leave empty with `anySubjectClient`."
  subjectClients: [String!] = []
  "Any client of the tenant's tokens may be exchanged. Default false."
  anySubjectClient: Boolean = false
  "Also exchange the tokens of the tenant's agents, with or without `subjectClients`. Default false."
  subjectAgents: Boolean = false
}

type Query {
  """
  The tenant's clients in id order (`q` matches part of the name or id, whatever the case).
  `kind` keeps only those registrations (`[CONSOLE]` for the registered clients, `[DYNAMIC,
  METADATA]` for the agents); left out or empty: every client. `totalCount` honours `q` and `kind`.
  Needs `view` on the tenant.
  """
  clients(
    tenantId: ID!
    q: String
    kind: [ClientRegistration!]
    after: String
    first: Int = 25
  ): ClientPage!
  "A client, an agent included (a metadata-document one too). `null` for an unknown id."
  client(tenantId: ID!, id: ID!): Client
}

type Mutation {
  "Needs `edit` on the tenant. Errors: CONFLICT (id taken by a client with other values, also when two calls race), QUOTA_EXCEEDED (409, past the plan's `clients` quota). A repeat of a call whose audit record failed (same id, name, type and redirect URIs) returns the stored client with `clientSecret: null` and records the missed event."
  createClient(tenantId: ID!, input: CreateClientInput!): CreatedClient!
  "Needs `edit`. NOT_FOUND for an unknown client or an agent (dynamic or metadata: read-only)."
  updateClient(tenantId: ID!, id: ID!, input: UpdateClientInput!): Client!
  "Needs `edit`. NOT_FOUND for an unknown client or an agent; BAD_USER_INPUT for a public client."
  rotateClientSecret(tenantId: ID!, id: ID!): RotatedClientSecret!
  """
  Replaces the client's token exchange rules. Needs `edit`. NOT_FOUND for an
  unknown client or an agent (read-only). The client must be a
  confidential one (BAD_USER_INPUT otherwise) and each target a resource of the
  tenant (BAD_USER_INPUT). The client also lists `TOKEN_EXCHANGE` in its grants
  for the rules to apply.
  """
  setClientTokenExchange(
    tenantId: ID!
    id: ID!
    input: ClientTokenExchangeInput!
  ): Client!
  "Deletes the client and its token exchange rules, and revokes its grants and their tokens. An agent is deleted the same way and its record goes with it (it frees the `agents` quota); a metadata-document agent is fetched and recorded again at its next use. `true` when the client was deleted, `false` when it was already gone or is not a client the console manages (left untouched)."
  deleteClient(tenantId: ID!, id: ID!): Boolean!
}
