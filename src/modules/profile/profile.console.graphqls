"""
A standard profile field a tenant may lock. A locked field cannot be changed by
the users themselves (their own `updateMyProfile`); the console admins still
edit it.
"""
enum ProfileField {
  NAME
  GIVEN_NAME
  FAMILY_NAME
  NICKNAME
  PHONE
  PICTURE
  LOCALE
  ZONEINFO
  BIRTHDATE
  ADDRESS
}

"""
The profile fields a tenant locks for its users' own edits. `version` rises on
every change (0 while the tenant never set one): pass the one you read back to
`updateProfilePolicy`. It is a document of its own: it never bumps the tenant's
`version`.
"""
type ProfilePolicy {
  tenantId: ID!
  "The locked fields, in the order of the enum."
  locked: [ProfileField!]!
  version: Int!
  "When the locks last changed; null while the tenant never set any."
  updatedAt: DateTime
}

extend type Query {
  "The tenant's profile locks (tenant viewer): nothing locked while it set none. NOT_FOUND for an unknown tenant."
  profilePolicy(tenantId: ID!): ProfilePolicy!
}

extend type Mutation {
  """
  Replaces the tenant's locked profile fields (tenant admin), at the `version`
  the caller read: a stale one is CONFLICT (409), so two admins never overwrite
  each other. A repeat of the same list stores nothing. Errors: NOT_FOUND for an
  unknown tenant.
  """
  updateProfilePolicy(
    tenantId: ID!
    locked: [ProfileField!]!
    version: Int!
  ): ProfilePolicy!
}

"""
The standard profile fields of a user. A field that is not set is null; the
picture is its storage key, never a URL.
"""
type UserProfile {
  givenName: String
  familyName: String
  nickname: String
  phone: UserPhone
  "A BCP 47 language tag, canonical (`fr-CA`)."
  locale: String
  "An IANA time zone name (`America/Toronto`)."
  zoneinfo: String
  "`YYYY-MM-DD`."
  birthdate: String
  address: UserAddress
  "The key of the user's picture, or null. Never a URL."
  pictureKey: String
  "When the user record last changed."
  updatedAt: DateTime!
}

"A phone number, E.164, and whether a console admin marked it proved (no SMS)."
type UserPhone {
  number: String!
  verified: Boolean!
}

"A postal address; every part is optional."
type UserAddress {
  formatted: String
  streetAddress: String
  locality: String
  region: String
  postalCode: String
  "ISO 3166-1 alpha-2, upper case."
  country: String
}

"A postal address to store. A blank part is left out; an address with no part left is cleared."
input AddressInput {
  formatted: String
  streetAddress: String
  locality: String
  region: String
  postalCode: String
  "ISO 3166-1 alpha-2."
  country: String
}

extend type Mutation {
  """
  Marks the user's address verified or not (tenant admin), touching nothing
  else: no session, password or second factor changes. Idempotent. Errors:
  NOT_FOUND for an unknown user.
  """
  setUserEmailVerified(
    tenantId: ID!
    userId: ID!
    verified: Boolean!
  ): TenantUser!
}
