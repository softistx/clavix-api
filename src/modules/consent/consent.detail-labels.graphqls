"""
Which line of a detail block a row is. The page words the fixed ones from its own catalogue; the API sends no
language of its own for them.
"""
enum ConsentRowKind {
  "The request's resource (RFC 9396 `locations`)."
  LOCATIONS
  "The actions the detail asks for; each value is the type's label for it."
  ACTIONS
  "A field the tenant's type defines: `key` and `label` are its own."
  FIELD
  "RFC 9396 `identifier`."
  IDENTIFIER
  "RFC 9396 `datatypes`."
  DATATYPES
}

"Which member of a `ConsentDetailValue` is set."
enum ConsentValueKind {
  TEXT
  NUMBER
  BOOLEAN
}

"""
One value of a row, typed: `text` for a string (a tenant's own label in the viewer's language for an enum or an
action), `number` for a number and `boolean` for a boolean. Exactly the member `kind` names is set. The page formats
numbers and words booleans (yes / no) itself.
"""
type ConsentDetailValue {
  kind: ConsentValueKind!
  text: String
  number: Float
  boolean: Boolean
}

"One line of an authorization detail: a stable `kind`, and its typed values (one per item of a list)."
type ConsentDetailRow {
  kind: ConsentRowKind!
  "The field's key when `kind` is `field`, `null` otherwise."
  key: String
  "The field's label in the viewer's language (`Accept-Language`, the key when the tenant wrote none); `null` unless `kind` is `field`."
  label: String
  values: [ConsentDetailValue!]!
}

"""
One authorization detail (RFC 9396) of a pending request, in words: the type's name and description from the
tenant's texts, and its rows. Never raw JSON. Approval allows every detail or none (D4).
"""
type ConsentDetail {
  "The detail's type, as the client asked for it."
  type: String!
  "The type's name in the viewer's language (`Accept-Language`), the type itself when the tenant wrote none."
  title: String!
  "What the type allows, in the viewer's language; empty when the tenant wrote none."
  description: String!
  rows: [ConsentDetailRow!]!
}

extend type OAuthRequest {
  "The request's authorization details in words, one block each; empty when it asked for none."
  details: [ConsentDetail!]!
  """
  False when a detail cannot be fully described (its type was deleted, or it carries a key, action or value its
  type no longer defines): the page must not offer approval, only deny, and approval is refused server-side with
  `invalid_authorization_details`. True when there is nothing to describe.
  """
  detailsComplete: Boolean!
}

extend type OAuthDeviceRequest {
  "The device's authorization details in words, one block each; empty when it asked for none."
  details: [ConsentDetail!]!
  "As `OAuthRequest.detailsComplete`."
  detailsComplete: Boolean!
}
