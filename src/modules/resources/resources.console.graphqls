"""
A text in one language. A list of translations holds at most one text per
locale; no language is built in.
"""
type Translation {
  locale: Locale!
  text: String!
}

"""
A text to set in one language (a BCP 47 tag, `fr`, `en-CA`...). In a list, a
write sets or replaces the locales it names and keeps the others; a blank
`text` removes that locale.
"""
input TranslationInput {
  locale: Locale!
  text: String!
}

"""
A scope of a tenant: what a client may ask for. The consent page shows its
description in the viewer's language (`Accept-Language`, then its base
language, then the first translation; the name when there is none).
"""
type Scope {
  id: ID!
  "The OAuth scope token. Unique in its resource (or among the standard scopes); never changes."
  name: String!
  description: [Translation!]!
  "The resource it belongs to; `null` for a standard OpenID Connect scope."
  resourceId: ID
  "The claims it opens."
  claims: [String!]!
}

"A protected API of a tenant (RFC 8707): `uri` is the audience of its access tokens."
type Resource {
  id: ID!
  uri: String!
  name: String!
  scopes: [Scope!]!
  "The authorization detail types (RFC 9396) it accepts, by name."
  detailTypes: [DetailType!]!
  """
  Where the resource server serves its RFC 9728 protected resource metadata:
  `/.well-known/oauth-protected-resource` plus the URI's path, on the URI's
  own origin. Clavix hosts no copy. `null` when the tenant's host does not
  resolve (the document needs its issuer).
  """
  metadataUrl: String
  """
  The RFC 9728 document (JSON text) the resource server serves at
  `metadataUrl`, as janus's `protectedResource()` answers it: the resource,
  this tenant's issuer, the resource's scopes and, when the tenant requires
  DPoP, its algorithms. Authorization detail types are not in it yet. `null`
  when the tenant's host does not resolve.
  """
  protectedResourceMetadata: String
  """
  Whether the resource accepts access tokens of the client credentials grant
  (RFC 6749 section 4.4): a client with `CLIENT_CREDENTIALS` may ask for a
  token whose audience is this resource, with no user behind it. Default
  false. The API must also accept such a token (a client-only token is
  refused by default).
  """
  allowClientCredentials: Boolean!
  createdAt: DateTime!
}

"The kind of one field of a detail type (a bounded list, never a free JSON Schema)."
enum DetailFieldKind {
  STRING
  NUMBER
  INTEGER
  BOOLEAN
  "One of `values`."
  ENUM
  "A list of strings: `max` items, `maxLength` per item."
  STRING_LIST
}

"A value of an `enum` field or an action, with the words the consent page shows."
type DetailValue {
  value: String!
  label: [Translation!]!
}

"One field of a detail type."
type DetailField {
  key: String!
  kind: DetailFieldKind!
  label: [Translation!]!
  required: Boolean!
  "Numbers: the lowest value."
  min: Float
  "Numbers: the highest value. A string list: the most items."
  max: Float
  "Strings (and each item of a list): the longest text."
  maxLength: Int
  "An enum's allowed values."
  values: [DetailValue!]
}

"""
An authorization detail type (RFC 9396) of a resource: what a client may ask
for as an `authorization_details` entry, and the words the consent page uses.
The `type` is unique in the tenant and never changes.
"""
type DetailType {
  id: ID!
  resourceId: ID!
  type: String!
  name: [Translation!]!
  description: [Translation!]!
  fields: [DetailField!]!
  "The RFC 9396 `actions` the type allows; empty when it takes none."
  actions: [DetailValue!]!
  createdAt: DateTime!
  updatedAt: DateTime!
}

input DetailValueInput {
  value: String!
  label: [TranslationInput!]
}

input DetailFieldInput {
  "A letter, then letters, digits or `_` (64 characters at most); not an RFC 9396 field name."
  key: String!
  kind: DetailFieldKind!
  label: [TranslationInput!]
  required: Boolean
  min: Float
  max: Float
  maxLength: Int
  values: [DetailValueInput!]
}

"At most 16 fields, 100 characters per label, 300 per description."
input CreateDetailTypeInput {
  resourceId: ID!
  "1 to 64 letters, digits, `_ . : -`, starting with a letter; unique in the tenant, never changes."
  type: String!
  name: [TranslationInput!]!
  description: [TranslationInput!]
  fields: [DetailFieldInput!]!
  actions: [DetailValueInput!]
}

"""
Fields left out stay as they are; `name` and `description` set or replace the
locales they list and keep the others (a blank text removes a locale);
`fields` and `actions` replace the whole list (`actions: []` clears it). The type name and the resource never change.
"""
input UpdateDetailTypeInput {
  name: [TranslationInput!]
  description: [TranslationInput!]
  fields: [DetailFieldInput!]
  actions: [DetailValueInput!]
}

input CreateResourceInput {
  "An https URI (http on a loopback host), canonical form, no fragment; never changes."
  uri: String!
  "Default: the URI's host."
  name: String
}

input CreateScopeInput {
  name: String!
  description: [TranslationInput!]
  "Leave out for a standard OpenID Connect scope."
  resourceId: ID
  claims: [String!]
}

"Fields left out stay as they are. The URI never changes: tokens carry it as their audience."
input UpdateResourceInput {
  name: String
  "Let clients with `CLIENT_CREDENTIALS` ask for tokens for this resource; turning it off refuses new token requests at once. Refused on the console's own resource."
  allowClientCredentials: Boolean
}

"""
Fields left out stay as they are; `description` sets or replaces the locales it
lists and keeps the others (a blank text removes a locale). The name and the
resource never change.
"""
input UpdateScopeInput {
  description: [TranslationInput!]
  claims: [String!]
}

type Query {
  "Needs `view` on the tenant."
  resources(tenantId: ID!): [Resource!]!
  resource(tenantId: ID!, id: ID!): Resource
  "All the tenant's scopes, standard ones included; `resourceId` narrows to one resource's."
  scopes(tenantId: ID!, resourceId: ID): [Scope!]!
}

type Mutation {
  "Needs `edit` on the tenant. A URI another resource has is a CONFLICT."
  createResource(tenantId: ID!, input: CreateResourceInput!): Resource!
  updateResource(tenantId: ID!, id: ID!, input: UpdateResourceInput!): Resource!
  "Deletes the resource, its scopes and its detail types (they leave the clients' lists). `false` when it was already gone."
  deleteResource(tenantId: ID!, id: ID!): Boolean!
  "A name another scope has is a CONFLICT."
  createScope(tenantId: ID!, input: CreateScopeInput!): Scope!
  updateScope(tenantId: ID!, id: ID!, input: UpdateScopeInput!): Scope!
  "`false` when it was already gone."
  deleteScope(tenantId: ID!, id: ID!): Boolean!
  "A name the tenant already has is a CONFLICT; an invalid definition is BAD_USER_INPUT; another tenant's resource is NOT_FOUND."
  createDetailType(tenantId: ID!, input: CreateDetailTypeInput!): DetailType!
  "Nothing is written when nothing changes."
  updateDetailType(
    tenantId: ID!
    id: ID!
    input: UpdateDetailTypeInput!
  ): DetailType!
  "`false` when it was already gone. DETAIL_TYPE_IN_USE (409) while a client lists it."
  deleteDetailType(tenantId: ID!, id: ID!): Boolean!
}
