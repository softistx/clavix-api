# Copy to deploy/.env (never committed) and fill. Read by docker compose for
# interpolation and handed to the api and the ui as their environment.
# Reference of every variable: docs/operations.md, "Environment".

# Images (built and pushed by you; CI does not).
CLAVIX_API_IMAGE=registry.example.com/clavix-api:0.1.0
CLAVIX_UI_IMAGE=registry.example.com/clavix-ui:0.1.0

# The apex: tenants live at <slug>.<CLAVIX_DOMAIN>, the console at console.<CLAVIX_DOMAIN>.
CLAVIX_DOMAIN=clavix.example.com
ACME_EMAIL=ops@example.com

# Secrets: generate each one, keep them in a secret manager apart from the database.
# Redis requirepass, also the password in the api's REDIS_URL: openssl rand -hex 24
REDIS_PASSWORD=change-me-openssl-rand-hex-24
# MongoDB authentication (docs/operations.md, "MongoDB"). Use hex values, they sit in a URI.
# The root user initiates the replica set at start-up; the api, backup and
# restore use the app user, readWrite and dbAdmin on the clavix database only.
MONGO_ROOT_USER=root
# openssl rand -hex 24
MONGO_ROOT_PASSWORD=change-me-openssl-rand-hex-24
MONGO_APP_USER=clavix
# openssl rand -hex 24
MONGO_APP_PASSWORD=change-me-openssl-rand-hex-24
# Replica-set internal authentication, 6 to 1024 characters: openssl rand -hex 64
MONGO_KEYFILE=change-me-openssl-rand-hex-64
# Optional TLS between the containers: MONGO_TLS_DIR (default deploy/tls) holds
# server/ (mongo.pem and ca.pem, for mongo only) and ca/ (ca.pem, for the clients).
# Set the options below to turn it on (docs/operations.md, "MongoDB").
# MONGO_TLS_DIR=./tls
# MONGO_URI_OPTIONS=&tls=true&tlsCAFile=/etc/mongo-tls-ca/ca.pem
# openssl rand -base64 32 -- losing it loses every tenant's signing keys.
CLAVIX_KEYS_MASTER_KEY=
# openssl rand -hex 32 (at least 32 characters); shared by the api and caddy.
CLAVIX_TLS_ASK_SECRET=
CLAVIX_SMTP_URL=smtps://user:password@smtp.example.com:465

# The ui (clavix-ui README, "Deploy").
CONTACT_EMAIL=support@example.com
# The console's OAuth client secret. It exists only after `db:migrate` (printed once) or
# `clients:create --client-id console --rotate-secret`: keep this placeholder until then,
# replace it, and only then start the ui (docs/operations.md, "First boot"). Compose
# refuses an empty value, so do not blank it.
CONSOLE_CLIENT_SECRET=pending-db-migrate
# Signs the console's session cookie: 32 characters or more, `openssl rand -base64 48`.
CONSOLE_SESSION_SECRET=

# The private bucket of the profile pictures: compose runs minio (container
# clavix-minio, private network only) and minio-init creates the bucket and the
# api's user from these (docs/operations.md, "Profile pictures"). Use hex values
# (they sit in a URL): openssl rand -hex 16 / openssl rand -hex 24
MINIO_ROOT_USER=change-me-openssl-rand-hex-16
MINIO_ROOT_PASSWORD=change-me-openssl-rand-hex-24
CLAVIX_MEDIA_S3_ACCESS_KEY_ID=change-me-openssl-rand-hex-16
CLAVIX_MEDIA_S3_SECRET_ACCESS_KEY=change-me-openssl-rand-hex-24
# CLAVIX_MEDIA_S3_BUCKET=clavix-media
# CLAVIX_MEDIA_S3_REGION=us-east-1

# Backups: where the archives go on the host, how many to keep.
# BACKUP_DIR=../backups
# BACKUP_KEEP=14

# Off-host backup copy on S3-compatible storage (docs/operations.md, "Off-host
# copies"). Opt-in: leave the bucket empty to keep archives on the host only.
# BACKUP_OFFSITE_S3_BUCKET=
# BACKUP_OFFSITE_S3_ENDPOINT=https://s3.example.com
# BACKUP_OFFSITE_S3_REGION=
# BACKUP_OFFSITE_S3_ACCESS_KEY_ID=
# BACKUP_OFFSITE_S3_SECRET_ACCESS_KEY=
# BACKUP_OFFSITE_S3_PREFIX=clavix-backups
# BACKUP_OFFSITE_KEEP_DAYS=30

# Staging on the shared VPS (deploy/deploy.ts + compose.traefik.yml, docs/operations.md, "Staging").
# The file must be mode 600. Images are built on the host, so use local names:
#   CLAVIX_API_IMAGE=clavix-api:staging
#   CLAVIX_UI_IMAGE=clavix-ui:staging
#   CLAVIX_SMTP_URL: the VPS relay, see docs/operations.md, "Staging" (mail sent as no-reply@<domain>)
#   CLAVIX_DOMAIN=clavixid.com      # tenants at <slug>.clavixid.com
# The sibling checkout the ui image is built from (default ../../clavix-ui, relative to deploy/).
# CLAVIX_UI_CONTEXT=../../clavix-ui
# compose.yml still needs CLAVIX_TLS_ASK_SECRET and ACME_EMAIL to be set (any value):
# staging starts no caddy and never uses them.
