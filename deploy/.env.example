# Copy to deploy/.env (never committed) and fill. Read by docker compose for
# interpolation and handed to the api and the ui as their environment.
# Reference of every variable: docs/operations.md, "Environment".

# Images (built and pushed by you; CI does not).
CLAVIX_API_IMAGE=registry.example.com/clavix-api:0.1.0
CLAVIX_UI_IMAGE=registry.example.com/clavix-ui:0.1.0

# The apex: tenants live at <slug>.<CLAVIX_DOMAIN>, the console at console.<CLAVIX_DOMAIN>.
CLAVIX_DOMAIN=clavix.example.com
ACME_EMAIL=ops@example.com

# Secrets: generate each one, keep them in a secret manager apart from the database.
REDIS_PASSWORD=change-me-openssl-rand-hex-24
# openssl rand -base64 32 -- losing it loses every tenant's signing keys.
CLAVIX_KEYS_MASTER_KEY=
# openssl rand -hex 32 (at least 32 characters); shared by the api and caddy.
CLAVIX_TLS_ASK_SECRET=
CLAVIX_SMTP_URL=smtps://user:password@smtp.example.com:465

# The ui (clavix-ui README, "Deploy").
CONTACT_EMAIL=support@example.com
# The console's OAuth client secret. It exists only after `db:migrate` (printed once) or
# `clients:create --client-id console --rotate-secret`: keep this placeholder until then,
# replace it, and only then start the ui (docs/operations.md, "First boot"). Compose
# refuses an empty value, so do not blank it.
CONSOLE_CLIENT_SECRET=pending-db-migrate
# Signs the console's session cookie: 32 characters or more, `openssl rand -base64 48`.
CONSOLE_SESSION_SECRET=

# Backups: where the archives go on the host, how many to keep.
# BACKUP_DIR=../backups
# BACKUP_KEEP=14
