# Copy to .env, which Bun loads on every command: bun dev, bun test, bun start.

# number, optional, default 3000
PORT=3000

# mongodb:// or mongodb+srv:// URI with the database in its path, required.
# Transactions need a replica set.
MONGO_URI=mongodb://localhost:27017/clavix?replicaSet=rs0

# redis:// or rediss:// URL of the tenant cache. Required in production;
# unset elsewhere, there is no cache.
# REDIS_URL=redis://localhost:6379

# The apex of every tenant issuer (<slug>.<CLAVIX_DOMAIN>). Required in
# production; default clavix.localhost elsewhere.
CLAVIX_DOMAIN=clavix.localhost

# https or http, default https; http is refused in production.
CLAVIX_PUBLIC_SCHEME=http

# Port of the issuers when it is not the scheme's own, optional.
# CLAVIX_PUBLIC_PORT=3000

# 32 bytes in base64 (openssl rand -base64 32): encrypts the tenants' signing
# keys at rest. Required in production; a public development default elsewhere.
# Keep it in a secret manager, apart from the database: losing it loses the keys.
# CLAVIX_KEYS_MASTER_KEY=

# smtp:// or smtps:// URL of the server that sends the sign-in codes, from
# no-reply@<CLAVIX_DOMAIN>. Required in production; unset elsewhere, the
# e-mails stay in a memory mailer and nothing leaves the process.
# CLAVIX_SMTP_URL=smtps://user:password@smtp.example.com:465

# Sign-in code requests (requestSignInCode), on top of the per-address limit
# (5 per 10 min). Per client address and tenant, then per tenant. They need
# REDIS_URL; without it there is no such limit. Defaults shown.
# CLAVIX_CODE_IP_LIMIT=20
# CLAVIX_CODE_IP_WINDOW_SECONDS=600
# CLAVIX_CODE_TENANT_LIMIT=200
# CLAVIX_CODE_TENANT_WINDOW_SECONDS=3600

# Passkey sign-in options (passkeySignInOptions, anonymous): PASSKEY_THROTTLED,
# 429. Per client address and tenant, then per tenant; REDIS_URL needed, as
# above. Defaults shown.
# CLAVIX_PASSKEY_IP_LIMIT=60
# CLAVIX_PASSKEY_IP_WINDOW_SECONDS=600
# CLAVIX_PASSKEY_TENANT_LIMIT=600
# CLAVIX_PASSKEY_TENANT_WINDOW_SECONDS=3600

# Magic-link sign-in, a global switch, off by default. Nothing in the API
# offers it yet (clavix-api#89); with it off, janus refuses the flow with
# MAGIC_LINK_DISABLED (404). true / 1 turn it on.
# CLAVIX_MAGIC_LINK=false

# Reverse proxies in front of the app, default 0: the client address is the
# connection's. N: it is the entry N places from the right of X-Forwarded-For.
# Set it only when every request goes through those proxies. Required in
# production (0 if there is no proxy): the app refuses to start without it.
# CLAVIX_TRUSTED_PROXIES=0
