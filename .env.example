# Copy to .env, which Bun loads on every command: bun dev, bun test, bun start.

# number, optional, default 3000
PORT=3000

# mongodb:// or mongodb+srv:// URI with the database in its path, required.
# Transactions need a replica set.
MONGO_URI=mongodb://localhost:27017/clavix?replicaSet=rs0

# redis:// or rediss:// URL of the tenant cache. Required in production;
# unset elsewhere, there is no cache.
# REDIS_URL=redis://localhost:6379

# The apex of every tenant issuer (<slug>.<CLAVIX_DOMAIN>). Required in
# production; default clavix.localhost elsewhere.
CLAVIX_DOMAIN=clavix.localhost

# https or http, default https; http is refused in production.
CLAVIX_PUBLIC_SCHEME=http

# Port of the issuers when it is not the scheme's own, optional.
# CLAVIX_PUBLIC_PORT=3000

# 32 bytes in base64 (openssl rand -base64 32): encrypts the tenants' signing
# keys at rest. Required in production; a public development default elsewhere.
# Keep it in a secret manager, apart from the database: losing it loses the keys.
# To rotate it, a comma-separated list, first = current (docs/operations.md):
# CLAVIX_KEYS_MASTER_KEY=<new>,<old>
# CLAVIX_KEYS_MASTER_KEY=

# smtp:// or smtps:// URL of the server that sends the sign-in codes, from
# no-reply@<CLAVIX_DOMAIN>. Required in production; unset elsewhere, the
# e-mails stay in a memory mailer and nothing leaves the process.
# CLAVIX_SMTP_URL=smtps://user:password@smtp.example.com:465

# Sign-in code requests (requestSignInCode), on top of the per-address limit
# (5 per 10 min). Per client address and tenant, then per tenant. They need
# REDIS_URL; without it there is no such limit. Defaults shown.
# CLAVIX_CODE_IP_LIMIT=20
# CLAVIX_CODE_IP_WINDOW_SECONDS=600
# CLAVIX_CODE_TENANT_LIMIT=200
# CLAVIX_CODE_TENANT_WINDOW_SECONDS=3600

# Passkey sign-in options (passkeySignInOptions, anonymous): PASSKEY_THROTTLED,
# 429. Per client address and tenant, then per tenant; REDIS_URL needed, as
# above. Defaults shown.
# CLAVIX_PASSKEY_IP_LIMIT=60
# CLAVIX_PASSKEY_IP_WINDOW_SECONDS=600
# CLAVIX_PASSKEY_TENANT_LIMIT=600
# CLAVIX_PASSKEY_TENANT_WINDOW_SECONDS=3600

# E-mail verification requests (requestEmailVerification, signed in):
# EMAIL_VERIFICATION_THROTTLED, 429. Per user, per client address and tenant,
# then per tenant; REDIS_URL needed, as above. Defaults shown.
# CLAVIX_VERIFY_USER_LIMIT=10
# CLAVIX_VERIFY_USER_WINDOW_SECONDS=3600
# CLAVIX_VERIFY_IP_LIMIT=20
# CLAVIX_VERIFY_IP_WINDOW_SECONDS=600
# CLAVIX_VERIFY_TENANT_LIMIT=200
# CLAVIX_VERIFY_TENANT_WINDOW_SECONDS=3600
# Durable webhook queue caps (per tenant, all instances together): requests in
# flight at once, and deliveries held. One tenant's flood or slow receiver
# cannot starve another tenant's endpoints. A delivery past the second cap is
# refused (logged, never retried). Defaults shown. Every instance must run the
# same values, and janus-webhooks-redis 0.13 or later (docs/operations.md).
# CLAVIX_WEBHOOKS_MAX_IN_FLIGHT=4
# CLAVIX_WEBHOOKS_MAX_PENDING=5000
# Dynamic client registration (POST /register, agents) and metadata-document
# fetches (/authorize, /par with a URL client_id): per client address and tenant,
# and per tenant. Redis only; the defaults are shown.
# CLAVIX_REGISTER_IP_LIMIT=20
# CLAVIX_REGISTER_IP_WINDOW_SECONDS=3600
# CLAVIX_REGISTER_TENANT_LIMIT=500
# CLAVIX_REGISTER_TENANT_WINDOW_SECONDS=3600
# hostedHomeRealm lookups and socialSignInStart calls (no mail sent): each has
# its own buckets, apart from the sign-in code ones, per client address and
# tenant, and per tenant. Redis only; the defaults are shown.
# CLAVIX_SSO_IP_LIMIT=60
# CLAVIX_SSO_IP_WINDOW_SECONDS=600
# CLAVIX_SSO_TENANT_LIMIT=2000
# CLAVIX_SSO_TENANT_WINDOW_SECONDS=3600
# Console sendTestWebhook: per endpoint and per tenant, over one window.
# CLAVIX_WEBHOOK_TEST_ENDPOINT_LIMIT=5
# CLAVIX_WEBHOOK_TEST_TENANT_LIMIT=20
# CLAVIX_WEBHOOK_TEST_WINDOW_SECONDS=60
# Console inviteUser / inviteAdmin: per caller and mutation (every aliased
# selection of a request counts), and per tenant, both mutations together.
# CLAVIX_INVITE_CALLER_LIMIT=60
# CLAVIX_INVITE_CALLER_WINDOW_SECONDS=3600
# CLAVIX_INVITE_TENANT_LIMIT=200
# CLAVIX_INVITE_TENANT_WINDOW_SECONDS=3600
# Pending invitations one tenant (and the admin list of one tenant) may hold;
# a new address past it is refused (PENDING_INVITATIONS_LIMIT). No Redis needed.
# CLAVIX_INVITE_PENDING_LIMIT=500
# Audit exports (GET /console/audit/export): starts per tenant. Redis only.
# CLAVIX_EXPORT_TENANT_LIMIT=10
# CLAVIX_EXPORT_TENANT_WINDOW_SECONDS=3600
# CLAVIX_METADATA_IP_LIMIT=30
# CLAVIX_METADATA_IP_WINDOW_SECONDS=60
# Ports a client metadata document may be served on (a client_id URL names the port).
# CLAVIX_METADATA_PORTS=443
# CLAVIX_METADATA_TENANT_LIMIT=300
# CLAVIX_METADATA_TENANT_WINDOW_SECONDS=60
# CLAVIX_DEVICE_USER_LIMIT=20
# CLAVIX_DEVICE_USER_WINDOW_SECONDS=600
# CLAVIX_DEVICE_IP_LIMIT=30
# CLAVIX_DEVICE_IP_WINDOW_SECONDS=600
# CLAVIX_DEVICE_TENANT_LIMIT=300
# CLAVIX_DEVICE_TENANT_WINDOW_SECONDS=3600

# The GraphQL IDE (Apollo Sandbox) and the schema's introspection on the hosted
# /graphql. A development tool: on under `bun dev` (NODE_ENV=development), off
# elsewhere; `true` is refused in production (the page runs a third-party
# script on the origin that holds the session cookie).
# CLAVIX_GRAPHQL_IDE=false

# Require the `x-clavix-client` header (any non-empty value) on /graphql and
# /console/graphql: a request without it gets 403 CLIENT_HEADER_REQUIRED before
# any parsing. Default false. Turn it on once every caller sends it (clavix-ui's
# U3 sender, `clavix-ui`, deployed); it then becomes the default.
# CLAVIX_REQUIRE_CLIENT_HEADER=false

# Reverse proxies in front of the app, default 0: the client address is the
# connection's. N: it is the entry N places from the right of X-Forwarded-For.
# Set it only when every request goes through those proxies. Required in
# production (0 if there is no proxy): the app refuses to start without it.
# CLAVIX_TRUSTED_PROXIES=0

# Automatic TLS "ask" (Caddy on_demand_tls): at least 32 characters. Caddy calls
# http://<app>/internal/tls/ask?token=<this value>&domain=<host> itself; the
# endpoint answers 404 to everyone while this is unset. Keep the URL on the
# private network and never expose /internal/ through the public proxy.
# CLAVIX_TLS_ASK_SECRET=
# Asks answered 200 per minute, all callers together (default 120). Past it:
# 429. An ask for an unknown host is a 404 and spends nothing.
# CLAVIX_TLS_ASK_LIMIT=120

# Traces and logs (OTLP/HTTP): the collector's base URL. Unset, nothing is exported.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Optional: key=value pairs separated by commas, sent on every export.
# OTEL_EXPORTER_OTLP_HEADERS=x-api-key=...
