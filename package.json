{
  "name": "clavix-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "nxgt-graphql-scalars typedefs --out && nxgt-graphql-validation typedefs --out && graphql-codegen --config codegen.ts",
    "dev": "NODE_ENV=development bun --watch src/server.ts",
    "build": "bun run generate && bun build src/server.ts --target=bun --outdir=dist --minify --sourcemap=linked",
    "start": "NODE_ENV=production bun dist/server.js",
    "test": "bun test --timeout=30000",
    "typecheck": "bun check",
    "db:sync": "bun src/scripts/db-sync.ts",
    "db:migrate": "bun src/scripts/db-migrate.ts",
    "tenants:create": "bun src/scripts/tenants-create.ts",
    "clients:create": "bun src/scripts/clients-create.ts",
    "resources:create": "bun src/scripts/resources-create.ts",
    "lint": "biome lint",
    "format": "biome format --write",
    "fix": "biome check --write",
    "check:ci": "biome ci",
    "verify": "bun run generate && bun run check:ci && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@alxia/core": "^0.19.0",
    "@alxia/env": "^0.5.0",
    "@alxia/graphql": "^0.14.0",
    "@graphql-tools/load-files": "^8.0.6",
    "@graphql-tools/merge": "^10.0.6",
    "@nxgt/graphql-scalars": "^0.7.1",
    "@nxgt/graphql-validation": "^0.8.1",
    "@softistx/janus": "^0.55.0",
    "@softistx/janus-graphql": "^0.24.2",
    "@softistx/janus-mail": "^0.25.8",
    "@softistx/janus-mongo": "^0.23.3",
    "@softistx/janus-oauth": "^0.8.4",
    "@softistx/janus-oauth-mongo": "^0.8.4",
    "@softistx/janus-oidc": "^0.3.3",
    "@softistx/janus-passkeys": "^0.3.1",
    "@softistx/mail": "^1.5.0",
    "@softistx/mail-smtp": "^1.1.0",
    "@softistx/mongo": "^0.29.0",
    "@softistx/redis": "~0.18.0",
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.24.2",
    "mongodb": "^7",
    "nodemailer": "^10.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/client-preset": "6.2.3",
    "@graphql-codegen/typescript": "6.1.2",
    "@graphql-codegen/typescript-resolvers": "6.1.1",
    "@graphql-tools/utils": "^13.1.3",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@nxgt/graphql-codegen-zod": "^0.4.0",
    "@types/bun": "^1.4.4",
    "jose": "^6.2.17",
    "mongodb-memory-server-core": "^11.3.0",
    "redis-memory-server": "^0.17.1",
    "typescript": "^7.0.2"
  }
}
