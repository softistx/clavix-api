{
  "name": "clavix-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "nxgt-graphql-scalars typedefs --out && nxgt-graphql-validation typedefs --out && graphql-codegen --config codegen.ts && graphql-codegen --config codegen.console.ts && limix-codegen generate --graphql schema.graphql --graphql console.schema.graphql",
    "dev": "NODE_ENV=development bun --watch src/server.ts",
    "build": "bun run generate && bun build src/server.ts --target=bun --outdir=dist --minify --sourcemap=linked",
    "start": "NODE_ENV=production bun dist/server.js",
    "test": "bun test --timeout=30000",
    "typecheck": "bun check",
    "authz:check": "limix-codegen generate --graphql schema.graphql --graphql console.schema.graphql --check",
    "schema:print": "bun src/scripts/schema-print.ts",
    "db:sync": "bun src/scripts/db-sync.ts",
    "db:migrate": "bun src/scripts/db-migrate.ts",
    "tenants:create": "bun src/scripts/tenants-create.ts",
    "clients:create": "bun src/scripts/clients-create.ts",
    "resources:create": "bun src/scripts/resources-create.ts",
    "keys:reseal": "bun src/scripts/keys-reseal.ts",
    "keys:rotate": "bun src/scripts/keys-rotate.ts",
    "operators:grant": "bun src/scripts/operators-grant.ts",
    "lint": "biome lint",
    "format": "biome format --write",
    "fix": "biome check --write",
    "check:ci": "biome ci",
    "verify": "bun run generate && bun run schema:print --check && bun run authz:check && bun run check:ci && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@graphql-tools/load-files": "^8.0.10",
    "@graphql-tools/merge": "^10.0.10",
    "@graphql-tools/utils": "^13.2.3",
    "@softistx/alxia": "^0.28.0",
    "@softistx/alxia-env": "^0.6.0",
    "@softistx/alxia-graphql": "^0.20.2",
    "@softistx/alxia-media": "^0.12.0",
    "@softistx/alxia-telemetry": "^0.10.0",
    "@softistx/graphql-scalars": "^0.8.0",
    "@softistx/graphql-validation": "^0.11.0",
    "@softistx/graxia": "^0.20.1",
    "@softistx/graxia-graphiql": "^0.5.1",
    "@softistx/janus": "^0.85.0",
    "@softistx/janus-graphql": "^0.38.7",
    "@softistx/janus-mail": "^0.26.29",
    "@softistx/janus-mongo": "^0.35.2",
    "@softistx/janus-oauth": "^0.28.5",
    "@softistx/janus-oauth-mongo": "^0.20.7",
    "@softistx/janus-oidc": "^0.6.5",
    "@softistx/janus-passkeys": "^0.3.33",
    "@softistx/janus-social": "^0.11.5",
    "@softistx/janus-telemetry": "^0.22.1",
    "@softistx/janus-webhooks": "^0.18.1",
    "@softistx/janus-webhooks-redis": "^0.15.1",
    "@softistx/limix": "^0.8.0",
    "@softistx/limix-alxia": "^0.3.4",
    "@softistx/limix-graxia": "^0.3.3",
    "@softistx/mail": "^1.6.1",
    "@softistx/mail-smtp": "^1.1.1",
    "@softistx/material-core": "^0.102.0",
    "@softistx/mongo": "^0.31.0",
    "@softistx/redis": "^0.24.1",
    "@softistx/s3": "^0.13.1",
    "@softistx/telemetry": "^0.5.0",
    "@softistx/telemetry-mongo": "^0.3.4",
    "@softistx/telemetry-otlp": "^0.3.3",
    "dataloader": "^2.2.3",
    "graphql": "^17.1.0",
    "mongodb": "^7",
    "nodemailer": "^10.6.1",
    "reflect-metadata": "^0.2.2",
    "tldts": "^7.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/client-preset": "6.2.3",
    "@graphql-codegen/typescript": "6.1.2",
    "@graphql-codegen/typescript-resolvers": "6.1.1",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@softistx/graphql-codegen-zod": "^0.6.1",
    "@softistx/limix-codegen": "^0.5.0",
    "@softistx/limix-janus": "^0.2.4",
    "@types/bun": "^1.4.5",
    "jose": "^6.2.17",
    "mongodb-memory-server-core": "^11.4.0",
    "redis-memory-server": "^0.17.1",
    "typescript": "^7.0.2"
  }
}
